// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// ENUMS
// =============================================

enum TransactionType {
  expense
  income
  transfer
}

enum TransactionSource {
  web
  bot_free
  bot_pro
  import
  open_finance
}

enum UserPlan {
  free
  pro
}

enum BillRecurrence {
  once
  monthly
  yearly
}

enum ReminderStatus {
  pending
  sent
  failed
}

enum OpenFinanceStatus {
  active
  error
  expired
  revoked
}

// =============================================
// USERS
// =============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  emailVerified Boolean   @default(false) @map("email_verified")
  passwordHash  String    @map("password_hash")
  provider      String    @default("email")
  plan          UserPlan  @default(free)
  creditCardLimit Decimal? @map("credit_card_limit") @db.Decimal(12, 2)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at") // soft delete (LGPD)

  // Relations
  emailVerifications EmailVerification[]
  refreshTokens      RefreshToken[]
  categories         Category[]
  transactions       Transaction[]
  telegramLink       TelegramLink?
  auditLogs          AuditLog[]
  bills              Bill[]
  openFinanceConns   OpenFinanceConnection[]

  @@map("users")
}

// =============================================
// EMAIL VERIFICATION
// =============================================

model EmailVerification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash") // bcrypt hash of the token
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

// =============================================
// REFRESH TOKENS
// =============================================

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash") // hash - never stored in plain text
  family    String    // UUID family for rotation attack detection
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// =============================================
// CATEGORIES
// =============================================

model Category {
  id        String          @id @default(uuid())
  userId    String?         @map("user_id") // null = global default category
  name      String          @db.VarChar(100)
  icon      String?         @db.VarChar(50)
  color     String?         @db.VarChar(7) // hex color
  type      TransactionType
  isDefault Boolean         @default(false) @map("is_default")
  createdAt DateTime        @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  bills        Bill[]

  @@map("categories")
}

// =============================================
// TRANSACTIONS
// =============================================

model Transaction {
  id                String            @id @default(uuid())
  userId            String            @map("user_id")
  categoryId        String?           @map("category_id")
  type              TransactionType
  paymentMethod     String?           @default("debit") @map("payment_method") // 'credit', 'debit', etc.
  installmentsCount Int?              @map("installments_count")
  installmentNumber Int?              @map("installment_number")
  installmentGroup  String?           @map("installment_group")
  amount            Decimal           @db.Decimal(12, 2)
  description       String?           // encrypted at application layer
  date              DateTime          @db.Date
  source            TransactionSource @default(web)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at") // soft delete

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, deletedAt])
  @@index([userId, installmentGroup])
  @@map("transactions")
}

// =============================================
// TELEGRAM LINKS
// =============================================

model TelegramLink {
  id                 String    @id @default(uuid())
  userId             String    @unique @map("user_id")
  telegramChatId     BigInt?   @unique @map("telegram_chat_id")
  linkCode           String?   @unique @db.VarChar(16) @map("link_code")
  linkCodeExpiresAt  DateTime? @map("link_code_expires_at")
  linkedAt           DateTime? @map("linked_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_links")
}

// =============================================
// AUDIT LOGS
// =============================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String   @db.VarChar(100)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  Json?    // extra context, no PII
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// =============================================
// BILLS — Pro feature
// =============================================

model Bill {
  id                String         @id @default(uuid())
  userId            String         @map("user_id")
  categoryId        String?        @map("category_id")
  name              String         @db.VarChar(200)
  amount            Decimal        @db.Decimal(12, 2)
  dueDay            Int            @map("due_day") @db.SmallInt
  recurrence        BillRecurrence @default(monthly)
  nextDueDate       DateTime       @map("next_due_date") @db.Date
  notifyDaysBefore  Int            @default(3) @map("notify_days_before") @db.SmallInt
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reminders BillReminder[]

  @@map("bills")
}

// =============================================
// BILL REMINDERS — Pro feature
// =============================================

model BillReminder {
  id        String         @id @default(uuid())
  billId    String         @map("bill_id")
  dueDate   DateTime       @map("due_date") @db.Date
  sentAt    DateTime?      @map("sent_at")
  status    ReminderStatus @default(pending)
  createdAt DateTime       @default(now()) @map("created_at")

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("bill_reminders")
}

// =============================================
// OPEN FINANCE CONNECTIONS — Pro abstraction
// =============================================

model OpenFinanceConnection {
  id               String            @id @default(uuid())
  userId           String            @map("user_id")
  provider         String            @db.VarChar(50) // 'pluggy', 'belvo', 'quanto'
  externalItemId   String?           @map("external_item_id")
  institutionName  String?           @db.VarChar(200) @map("institution_name")
  status           OpenFinanceStatus @default(active)
  consentExpiresAt DateTime?         @map("consent_expires_at")
  lastSyncAt       DateTime?         @map("last_sync_at")
  createdAt        DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("open_finance_connections")
}
